<Window x:Class="LB5_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="520" Width="350"
        Background="#2B2B2B" ResizeMode="NoResize">
    
    <Window.Resources>
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0F0F0" Offset="0"/>
            <GradientStop Color="#BDBDBD" Offset="0.5"/>
            <GradientStop Color="#E8E8E8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="MetalButton" TargetType="Button">
    
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource MetalBrush}"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="Padding" Value="6,4"/>

    
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
    
                                <Rectangle RadiusX="8" RadiusY="8"
                                           Fill="{TemplateBinding Background}"
                                           Opacity="1"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

                <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#DADADA" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#9A9A9A" Offset="0"/>
                                <GradientStop Color="#707070" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#888888"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <TextBox x:Name="txtHistory"
                 Grid.Row="0"
                 Margin="5"
                 Height="30"
                 IsReadOnly="True"
                 Background="#3A3A3A"
                 Foreground="#CCCCCC"
                 BorderThickness="0"
                 TextAlignment="Right"
                 FontSize="14"
                 Text=""/>

       
        <TextBox x:Name="txtInput"
                 Grid.Row="1"
                 Margin="5"
                 Height="50"
                 IsReadOnly="True"
                 Background="#3A3A3A"
                 Foreground="White"
                 BorderThickness="0"
                 TextAlignment="Right"
                 FontSize="24"
                 Text=""/>


        <Grid Grid.Row="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <Button Grid.Row="0" Grid.Column="0" Content="C" Click="ClearAll_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="CE" Click="ClearEntry_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="0" Grid.Column="2" Content="&lt;" Click="Backspace_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="0" Grid.Column="3" Content="/" Click="Operation_Click" Style="{StaticResource MetalButton}"/>


            <Button Grid.Row="1" Grid.Column="0" Content="7" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="1" Grid.Column="3" Content="*" Click="Operation_Click" Style="{StaticResource MetalButton}"/>


            <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="2" Grid.Column="3" Content="-" Click="Operation_Click" Style="{StaticResource MetalButton}"/>


            <Button Grid.Row="3" Grid.Column="0" Content="1" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="3" Grid.Column="3" Content="+" Click="Operation_Click" Style="{StaticResource MetalButton}"/>


            <Button Grid.Row="4" Grid.Column="0" Content="0" Click="Number_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="4" Grid.Column="1" Content="." Click="Dot_Click" Style="{StaticResource MetalButton}"/>
            <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Content="=" Click="Equals_Click" Style="{StaticResource MetalButton}"/>
        </Grid>
    </Grid>
</Window>
