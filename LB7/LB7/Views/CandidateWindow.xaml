<Window x:Class="Lb7.Views.CandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кандидат" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="П.І.Б.:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Рік народження:" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox Text="{Binding BirthYear}" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Освіта:" Grid.Row="2" VerticalAlignment="Center"/>
        <ComboBox SelectedValue="{Binding Education}" Grid.Row="2" Grid.Column="1" Margin="5">
            <ComboBoxItem Content="Середня"/>
            <ComboBoxItem Content="Середня спеціальна"/>
            <ComboBoxItem Content="Вища"/>
        </ComboBox>

        <TextBlock Text="Мови:" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Languages}" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <CheckBox IsChecked="{Binding ComputerSkills}" Content="Володіння ПК" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Стаж (років):" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Experience}" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <CheckBox IsChecked="{Binding HasRecommendation}" Content="Є рекомендації" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Зберегти" Click="Save_Click" Width="80" Margin="5"/>
            <Button Content="Скасувати" IsCancel="True" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>