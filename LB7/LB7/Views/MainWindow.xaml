<Window x:Class="Lb7.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lb7.ViewModels"
        Title="Відділ кадрів (Lb7)" Height="450" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Пошук: " VerticalAlignment="Center"/>
            <TextBox Width="200" 
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="5,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Candidates}" 
                  SelectedItem="{Binding SelectedCandidate}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="П.І.Б." Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Рік" Binding="{Binding BirthYear}" Width="60"/>
                <DataGridTextColumn Header="Освіта" Binding="{Binding Education}" Width="100"/>
                <DataGridTextColumn Header="Мови" Binding="{Binding Languages}" Width="150"/>
                <DataGridCheckBoxColumn Header="ПК" Binding="{Binding ComputerSkills}" Width="40"/>
                <DataGridTextColumn Header="Стаж" Binding="{Binding Experience}" Width="40"/>
                <DataGridCheckBoxColumn Header="Реком." Binding="{Binding HasRecommendation}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Додати" Command="{Binding AddCommand}" Width="100" Margin="5"/>
            <Button Content="Редагувати" Command="{Binding EditCommand}" Width="100" Margin="5"/>
            <Button Content="Видалити" Command="{Binding DeleteCommand}" Width="100" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>