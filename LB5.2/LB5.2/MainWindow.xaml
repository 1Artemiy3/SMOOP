<Window x:Class="LB5_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BestOil" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="58*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        
        <GroupBox Header="Автозаправка" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="Бензин:" Margin="0,5,0,0"/>
                <ComboBox x:Name="FuelComboBox" SelectionChanged="FuelComboBox_SelectionChanged" />

                <TextBlock Text="Ціна (грн/л):" Margin="0,5,0,0"/>
                <TextBox x:Name="PriceTextBox" IsReadOnly="True" Text="0.00" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="QuantityRadio" Content="Кількість (л)" IsChecked="True" Checked="Radio_Checked" Margin="0,0,10,0"/>
                    <RadioButton x:Name="SumRadio" Content="Сума (грн)" Checked="Radio_Checked" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Кількість:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="QuantityTextBox" Width="80" Text="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Сума:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="SumTextBox" Width="80" IsEnabled="False" Text="0"/>
                </StackPanel>

                <GroupBox Header="До оплати:" Margin="0,10,0,0">
                    <TextBlock x:Name="FuelTotalLabel" FontSize="20" Text="0.00 грн." HorizontalAlignment="Center"/>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Header="Міні-Кафе" Grid.Row="0" Grid.Column="2" Margin="5,5,5,5">
            <StackPanel>
                <CheckBox x:Name="HotDogCheck" Content="Хот-дог" Checked="CafeCheck_Changed" Unchecked="CafeCheck_Changed" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ціна:" Width="50" VerticalAlignment="Center"/>
                    <TextBox x:Name="HotDogPrice" Text="4.00" IsReadOnly="True" Width="50"/>
                    <TextBlock Text="Кількість:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="HotDogQuantity" IsEnabled="False" Width="50" Text="0"/>
                </StackPanel>

                <CheckBox x:Name="HamburgerCheck" Content="Гамбургер" Checked="CafeCheck_Changed" Unchecked="CafeCheck_Changed" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ціна:" Width="50" VerticalAlignment="Center"/>
                    <TextBox x:Name="HamburgerPrice" Text="5.40" IsReadOnly="True" Width="50"/>
                    <TextBlock Text="Кількість:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="HamburgerQuantity" IsEnabled="False" Width="50" Text="0"/>
                </StackPanel>

                <GroupBox Header="До оплати:" Margin="0,10,0,0">
                    <TextBlock x:Name="CafeTotalLabel" FontSize="20" Text="0.00 грн." HorizontalAlignment="Center"/>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <!-- ВСЬОГО -->
        <GroupBox Header="ВСЬОГО до сплати" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,5,5,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button x:Name="CalculateButton" Content="Прорахувати" Width="150" Height="50" Click="CalculateButton_Click"/>
                <TextBlock x:Name="GrandTotalLabel" FontSize="30" Margin="20,0,0,0" Text="0.00 грн." VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
