<Window x:Class="Lb4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота №4 " Height="500" Width="700" WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl>
            <TabItem Header="Завдання 1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label x:Name="lblTask1" Content="Початок роботи" FontSize="24" HorizontalAlignment="Center" Margin="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Привіт" Click="Task1_Click" Width="120" Margin="10" Padding="5"/>
                        <Button Content="До побачення" Click="Task1_Click" Width="120" Margin="10" Padding="5"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Завдання 2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="txtBlockTask2" Text="Цей текст можна приховати" FontSize="20" Margin="20" Background="LightYellow" Padding="10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Сховати" Click="Task2_Hide_Click" Width="100" Margin="5"/>
                        <Button Content="Показати" Click="Task2_Show_Click" Width="100" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Завдання 3">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                    <TextBox x:Name="txtBoxTask3" Text="Введіть текст..." Margin="10" Padding="5" Height="30"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Приховати" Click="Task3_Hide_Click" Width="80" Margin="5"/>
                        <Button Content="Показати" Click="Task3_Show_Click" Width="80" Margin="5"/>
                        <Button Content="Очистити" Click="Task3_Clear_Click" Width="80" Margin="5"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Завдання 4 (Гра)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="Ціль: Приховати усі кнопки" FontSize="16" VerticalAlignment="Center"/>
                        <Button Content="Рестарт" Click="Task4_Restart_Click" Margin="20,0,0,0"/>
                    </StackPanel>

                    <UniformGrid x:Name="GameGrid" Grid.Row="1" Rows="2" Columns="3" Margin="20">
                        <Button Content="Кнопка 1" Background="#FFCCCC" Click="Task4_Btn_Click" Margin="10"/>
                        <Button Content="Кнопка 2" Background="#CCFFCC" Click="Task4_Btn_Click" Margin="10" FontWeight="Bold"/>
                        <Button Content="Кнопка 3" Background="#CCCCFF" Click="Task4_Btn_Click" Margin="10" FontStyle="Italic"/>
                        <Button Content="Кнопка 4" Background="#FFFFCC" Click="Task4_Btn_Click" Margin="10" FontSize="14"/>
                        <Button Content="Кнопка 5" Background="#E5CCFF" Click="Task4_Btn_Click" Margin="10" BorderThickness="3"/>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Завдання 5">
                <Grid Background="#66BB6A" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Фунти - кілограми" Foreground="White" Margin="10"/>

                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Вага у фунтах" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtPounds" FontSize="24" Grid.Column="1" Height="40" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Button Content="Розрахувати" Click="Task5_Calculate_Click" Grid.Row="2" 
                            Height="40" VerticalAlignment="Top" Margin="10" 
                            Background="#26A69A" Foreground="White" FontSize="18" FontWeight="Bold"/>

                    <StackPanel Grid.Row="3" Margin="10">
                        <TextBlock x:Name="lblResult" Text="0 кг" FontSize="36" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>