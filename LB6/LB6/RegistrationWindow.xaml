<Window x:Class="Lb6.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registration" Height="550" Width="400" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="REGISTRATION FORM" Style="{StaticResource HeaderStyle}"/>

                <TextBlock Text="First Name:"/>
                <TextBox x:Name="txtFirstName"/>

                <TextBlock Text="Last Name:"/>
                <TextBox x:Name="txtLastName"/>

                <TextBlock Text="Email:"/>
                <TextBox x:Name="txtEmail"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Age:"/>
                        <TextBox x:Name="txtAge"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Gender:"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Content="Male" GroupName="Gender" IsChecked="True" Margin="0,0,10,0"/>
                            <RadioButton Content="Female" GroupName="Gender"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Password:"/>
                <PasswordBox x:Name="txtRegPassword" Height="30" Margin="0,5,0,15" 
                             VerticalContentAlignment="Center" BorderBrush="#CCCCCC" BorderThickness="1"/>

                <TextBlock Text="Confirm Password:"/>
                <PasswordBox x:Name="txtConfirmPassword" Height="30" Margin="0,5,0,15" 
                             VerticalContentAlignment="Center" BorderBrush="#CCCCCC" BorderThickness="1"/>

                <CheckBox x:Name="chkAgree" Content="I agree to the Terms and Conditions" Margin="0,10"/>

                <Button Content="REGISTER" Click="Register_Click"/>
                <Button Content="Back to Login" Background="Gray" Click="Back_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>