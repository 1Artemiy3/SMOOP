<Window x:Class="Lb6.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="450" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Login" Style="{StaticResource HeaderStyle}"/>

            <TextBlock Text="Username:"/>
            <TextBox x:Name="txtUsername"/>

            <TextBlock Text="Password:"/>
            <PasswordBox x:Name="txtPassword" Height="30" Margin="0,5,0,15" VerticalContentAlignment="Center"/>

            <Button Content="LOGIN" Click="Login_Click"/>

            <TextBlock Text="Or Sign Up Using" HorizontalAlignment="Center" Margin="0,15,0,10" Foreground="Gray"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="F" Width="40" Background="#3B5998" Margin="5"/>
                <Button Content="G" Width="40" Background="#DB4437" Margin="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="No account yet? " Foreground="Gray"/>
                <TextBlock Text="SIGN UP" Foreground="{StaticResource PrimaryColor}" 
                           Cursor="Hand" MouseLeftButtonDown="SignUp_Click" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>